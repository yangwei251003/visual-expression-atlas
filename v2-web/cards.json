    "demoHtml": "<div id=\"demo-v2-feedback-states\" class=\"motion-v2\" data-motion=\"feedback\" data-duration=\"2000\" role=\"group\" aria-label=\"效果对照，可控播放器\">\n      <p class=\"mv-kicker\">同一进度 · 左右对照</p>\n      <div class=\"mv-compare\">\n        <section class=\"mv-pane\">\n          <div class=\"mv-label\"><b>即时动作反馈</b><span lang=\"en\">Immediate</span></div>\n          <div class=\"mv-stage\"><div class=\"mv-feedback-center\"><div class=\"mv-fake-button\"><i class=\"mv-ripple\"></i><span>保存</span></div><span class=\"mv-status\">等待操作</span><div class=\"mv-confirm-panel\"><b>✓</b> 保存成功</div></div></div>\n          <div class=\"mv-meter\">按压、处理中与完成</div>\n        </section>\n        <section class=\"mv-pane\">\n          <div class=\"mv-label\"><b>延迟反馈</b><span lang=\"en\">Delayed</span></div>\n          <div class=\"mv-stage\"><div class=\"mv-feedback-center\"><div class=\"mv-fake-button\"><i class=\"mv-ripple\"></i><span>保存</span></div><span class=\"mv-status\">等待操作</span><div class=\"mv-confirm-panel\"><b>✓</b> 保存成功</div></div></div>\n          <div class=\"mv-meter\">只在完成时显示结果</div>\n        </section></div>\n      <div class=\"mv-controls\">\n        <button type=\"button\" data-mv-action=\"play\">播放</button>\n        <button type=\"button\" data-mv-action=\"pause\" disabled>暂停</button>\n        <button type=\"button\" data-mv-action=\"reset\">回到起点</button>\n        <button type=\"button\" class=\"mv-action\">模拟保存</button>\n        <label class=\"mv-scrubber\"><span>进度</span>\n          <input class=\"mv-range\" type=\"range\" min=\"0\" max=\"1000\" value=\"350\" aria-label=\"两种效果的同步进度\">\n          <output class=\"mv-output\">35%</output>\n        </label>\n      </div>\n      <p class=\"mv-caption\">先模拟保存，再暂停在 20–60%。两侧任务完成时间相同，比较等待期间你能知道什么。</p>\n    </div>"
  }
